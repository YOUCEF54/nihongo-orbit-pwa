{
  "name": "nihongo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test src/lib/*.test.mts",
    "test:e2e": "playwright test",
    "db:link": "npx --yes supabase link",
    "db:push": "npx --yes supabase db push",
    "db:status": "npx --yes supabase migration list",
    "gen:wotd": "node scripts/gen-wotd-images.mjs",
    "gen:sectors": "node scripts/gen-sector-art.mjs",
    "gen:kanjivg": "node scripts/gen-kanjivg.mjs",
    "predev": "npm run gen:wotd && npm run gen:sectors && npm run gen:kanjivg",
    "prebuild": "npm run gen:wotd && npm run gen:sectors && npm run gen:kanjivg"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "framer-motion": "^14.2.0",
    "hanzi-writer": "^3.7.3",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
